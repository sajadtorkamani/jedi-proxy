# bcrypt hash of the dashboard password — the hash only, WITHOUT the "sajad:"
# prefix htpasswd prints (dynamic/prod/dashboard.yml adds it). Single quotes
# keep compose from interpolating its `$`s. The value below is "password";
# see the README for generating a real one on prod. Only compose.prod.yaml
# reads these two.
TRAEFIK_DASHBOARD_PWD_HASH='$2y$05$UJurV7FOUZ5w7YWNUqDeMeOW0sSfmFn9YbIH2naeU9qdcUEFuDklq'
TRAEFIK_DASHBOARD_DOMAIN='<enter-value-here>'

# No COMPOSE_FILE: the environment is chosen by the compose.override.yaml
# symlink instead (see compose.yaml). Leaving one here would override it.
